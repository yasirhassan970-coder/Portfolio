    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an intent classification engine for a customer support system.\nClassify the customer message into exactly ONE category: FAQ, Account, or Complaint.\n- FAQ: general product, feature, or policy questions answerable from a knowledge base.\n- Account: order status, billing, account details, or profile-specific requests requiring CRM lookup.\n- Complaint: dissatisfaction, refund disputes, or requests that require human escalation.\n\nCustomer message:\n{{$json.sanitizedMessage}}",
        "hasOutputParser": true
      },
      "id": "56aa257f-39ab-41af-aa28-b56411072c2e",
