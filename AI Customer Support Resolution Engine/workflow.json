    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst EMAIL_RE = /[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g;\nconst PHONE_RE = /(\\+?\\d{1,3}[-.\\s]?)?\\(?\\d{2,4}\\)?[-.\\s]?\\d{3,4}[-.\\s]?\\d{3,4}/g;\nconst CARD_RE = /\\b(?:\\d[ -]*?){13,16}\\b/g;\n\nreturn items.map((item) => {\n  const original = item.json.message || '';\n  let masked = original\n    .replace(EMAIL_RE, '[EMAIL_REDACTED]')\n    .replace(CARD_RE, '[CARD_REDACTED]')\n    .replace(PHONE_RE, '[PHONE_REDACTED]');\n\n  return {\n    json: {\n      ...item.json,\n      sanitizedMessage: masked,\n      piiMasked: masked !== original,\n      receivedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "76729c52-37e9-4265-bcfe-622388f0d68b",
